# Copy to .env and fill in. None of this is committed. Every value is optional in development;
# in production DAILY_SECRET is required.

# Where the server listens, and the address players use (for cookies, sign-in links and OAuth
# callbacks). In development with Vite, set PUBLIC_ORIGIN to the Vite address, e.g.
# http://localhost:5174, so emailed sign-in links open the app.
PORT=8788
PUBLIC_ORIGIN=http://localhost:8788
# Extra origins (comma separated) allowed to call the API and open the socket.
ALLOWED_ORIGINS=

# SQLite file (use a persistent volume in production; :memory: for a throwaway database).
DATABASE_PATH=data-local/world-game.sqlite

# Seeds the ranked dailies. Long and random; keep it secret and never change it mid-day.
#   openssl rand -hex 32
DAILY_SECRET=

# Set to 1 only behind a proxy you trust (Cloudflare, Caddy): addresses then come from
# CF-Connecting-IP / X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=
# With TRUST_PROXY=1, read the address from this one header only. Needed on Fly.io
# (fly-client-ip), whose proxy appends to X-Forwarded-For so its first entry can be faked.
# Leave empty behind Cloudflare or Caddy.
CLIENT_IP_HEADER=

# Sign-in emails. Without RESEND_API_KEY, links are printed to the log and kept in a
# development-only mailbox at /api/dev/mailbox (never in production).
RESEND_API_KEY=
MAIL_FROM=World Game <noreply@example.com>

# Sign in with Google or GitHub, each on only when both values are set. Callback URLs:
#   ${PUBLIC_ORIGIN}/api/auth/google/callback   and   ${PUBLIC_ORIGIN}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opens GET /admin/counters (send "Authorization: Bearer <token>"); closed when empty.
METRICS_TOKEN=

# Limits (defaults shown).
MAGIC_LINKS_PER_IP_PER_HOUR=10
NEW_SESSIONS_PER_IP_PER_HOUR=120
# One JSON log line per API request: on in production, set 0 or 1 to override.
LOG_REQUESTS=

# Backups with Litestream (docker/entrypoint.sh). Leave the URL empty to run without backups.
#   s3://<bucket>/world-game.sqlite   (an R2 or S3 bucket)
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# For R2 or MinIO: the service's S3 endpoint, e.g. https://<account>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
