{
  "name": "world-game",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "NODE_ENV=production node dist-server/index.js",
    "server:watch": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && npm run build:server && node scripts/precompress.mjs",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:data": "node scripts/build-countries.mjs",
    "build:cities": "node scripts/build-cities.mjs",
    "build:sub": "node scripts/build-subdivisions.mjs",
    "build:texture": "node scripts/build-texture.mjs",
    "build:flags": "node scripts/build-flags.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "arctic": "^3.7.0",
    "d3-geo": "^3.1.2",
    "hono": "^4.13.13",
    "obscenity": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "flag-icons": "^7.6.0",
    "mapshaper": "^0.8.7",
    "oxlint": "^1.88.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
